# Copy to .env.local for local overrides. Vite exposes only VITE_* variables.

# Backend base URL. Leave empty in dev to use the current hostname on port 8000.
VITE_API_URL=

# Optional bearer token; must match the backend token when auth is enabled.
VITE_API_TOKEN=

# Studio shell rollback. Set to false to keep /studio on the legacy editor.
VITE_STUDIO_ENABLED=true

# Comma-separated surface rollback, e.g. "shorts,setup". Unknown names are ignored.
VITE_STUDIO_DISABLED_SURFACES=
